# Cron News 配置模板
# 复制为 .env 并填写真实值后生效（.env 已被 git 忽略，不会提交）
#
# 大语言 / 文生图 / 搜索服务的配置项（服务商名称、Base URL、模型 ID、启用状态等）
# 以及各家的 API Key 统一存放在数据库（model_configs 表），API Key 使用 SECRET_KEY
# 加密后入库，无需在此填写。配置项在「设置 → 模型与服务配置」中维护。
# 预设厂商参考见 README 底部表格。

# ===== 加密密钥（首次启动自动生成，请保留勿删除）=====
SECRET_KEY=

# ===== 定时任务 =====
# 搜索计划表达式（由任务配置自动生成，亦可手动指定）
SEARCH_CRON=
# 最近一次搜索时间（系统自动更新）
LAST_SEARCH_TIME=
# 任务模式：preset=预设 / custom=自定义
TASK_MODE=
TASK_INTERVAL_HOURS=
TASK_START_HOUR=
TASK_CUSTOM_CRON=
TASK_SELECTED_CATEGORIES=

# ===== Agent =====
# 外部扩展提示词模式与内容（preset=内置预设 / custom=自定义）
AGENT_EXT_MODE=
AGENT_EXT_PROMPT=
# 智能推荐 / 每日简报 / 自动生成资讯封面 功能开关
AGENT_RECOMMEND_ENABLED=
AGENT_BRIEF_ENABLED=
AGENT_COVER_ENABLED=
# 工作模式：assist=辅助 / autonomous=自主
WORK_MODE=

# ===== 个人 =====
NICKNAME=
AVATAR_URL=

# ===== 独立数据库（可留空则使用系统 SQLite）=====
DB_MODE=
DB_TYPE=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
