# =========================================================
# Cron News（定时资讯）配置模板
# 复制本文件为 .env 并按需填写后生效（.env 已被 git 忽略，不会提交）。
#
# 重要说明：
#   1. 大多数日常配置（工作模式、自动任务、模型/搜索服务等）都在网页「设置」里维护，
#      保存时会自动写回本文件，你通常**不需要**手工编辑这些字段。
#   2. 大语言 / 文生图 / 搜索服务的 Base URL、模型 ID、启用状态、API Key 统一存放在
#      数据库（model_configs 表），API Key 用下面的 SECRET_KEY 加密后入库，
#      **不要在 .env 里填模型 API Key**，请在「设置 → 模型服务配置」中维护。
#   3. 预设厂商参考见 README 底部表格。
# =========================================================

# ===== 加密密钥 =====
# 用于加密数据库中的模型 API Key。首次启动会自动生成并写回，请保留勿删除。
# 换掉它会导致已保存的 API Key 无法解密（需在网页里重新填写）。
# 不需要自己填，留空即可（自动生成）。
SECRET_KEY=

# ===== 定时任务（自主模式下由「设置 → 自动任务配置」自动生成，一般无需手填）=====
# 搜索计划 cron 表达式（例：0 */8 * * * = 每 8 小时）。由网页任务配置自动推导。
SEARCH_CRON=
# 最近一次采集时间（系统自动更新，用于启动补跑判断），无需手填。
LAST_SEARCH_TIME=
# 任务模式：preset=预设 / custom=自定义（网页「触发频率」里切换）
TASK_MODE=
# 任务间隔（小时）：1/3/6/8/12/24（网页「时间间隔」）
TASK_INTERVAL_HOURS=
# 每日首次执行小时：0~23（网页「每日开始时间」）
TASK_START_HOUR=
# 自定义 cron 表达式（仅 TASK_MODE=custom 时生效）
TASK_CUSTOM_CRON=
# 参与采集的分类名 JSON 数组，例：["科技","军事"]（网页「分类选择」生成）
TASK_SELECTED_CATEGORIES=

# ===== Agent =====
# 外部扩展提示词模式：preset=内置预设 / custom=自定义
AGENT_EXT_MODE=
# 自定义扩展提示词内容（仅 AGENT_EXT_MODE=custom 时生效）
AGENT_EXT_PROMPT=
# 功能开关（网页「设置 → Agent 管理」切换）：
# AGENT_RECOMMEND_ENABLED=true 启用「智能推荐」（需已启用大语言模型）
# AGENT_BRIEF_ENABLED=true     启用「每日简报」（需已启用大语言模型）
# AGENT_COVER_ENABLED=true     启用「自动生成资讯封面」（需已启用文生图模型）
AGENT_RECOMMEND_ENABLED=
AGENT_BRIEF_ENABLED=
AGENT_COVER_ENABLED=
# 工作模式：assist=辅助（平台作展示，外部 Agent 推送）/ autonomous=自主（内置 Agent 自动采集）
# 在网页「工作模式」中切换，自动写回。
WORK_MODE=

# ===== 个人 =====
# 用户名（首次启动自动生成 User+6 位数字，可在「设置 → 个人资料」修改）
NICKNAME=
# 头像图片 URL（上传头像后自动写入，无需手填）
AVATAR_URL=

# ===== 独立数据库（可留空则使用系统内置 SQLite）=====
# 网页「设置 → 数据库」中配置并测试连接，保存后自动写回，一般无需手填。
# 留空即使用系统 SQLite（零配置开箱即用）。
# DB_MODE: system=系统 SQLite / standalone=独立数据库
DB_MODE=
# 数据库类型：mysql / mariadb / postgresql
DB_TYPE=
# 数据库主机地址
DB_HOST=
# 数据库端口（mysql/mariadb 默认 3306，postgresql 默认 5432）
DB_PORT=
# 数据库名称（会自动创建，如 cron_news）
DB_NAME=
# 数据库用户名
DB_USER=
# 数据库密码
DB_PASSWORD=
