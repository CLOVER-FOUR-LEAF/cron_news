# Cron News 配置模板
# 复制为 .env 并填写真实值后生效（.env 已被 git 忽略，不会提交）

# ===== 大语言模型（自主模式下 Agent 使用）=====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 大模型配置列表与当前启用项（JSON，通常由设置页维护，可留空）
LLM_CONFIGS=
ACTIVE_LLM=

# ===== 搜索服务（自主模式下定时采集使用）=====
SEARCH_BASE_URL=
SEARCH_API_KEY=
# 搜索服务配置列表与当前启用项（JSON，通常由设置页维护，可留空）
SEARCH_CONFIGS=
ACTIVE_SEARCH=

# ===== 定时任务 =====
# 搜索计划表达式（由任务配置自动生成，亦可手动指定）
SEARCH_CRON=
# 最近一次搜索时间（系统自动更新）
LAST_SEARCH_TIME=
# 任务模式：preset=预设 / custom=自定义
TASK_MODE=
TASK_INTERVAL_HOURS=
TASK_START_HOUR=
TASK_CUSTOM_CRON=
TASK_SELECTED_CATEGORIES=

# ===== Agent =====
# 外部扩展提示词模式与内容（preset=内置预设 / custom=自定义）
AGENT_EXT_MODE=
AGENT_EXT_PROMPT=
# 智能推荐 / 每日简报 功能开关
AGENT_RECOMMEND_ENABLED=
AGENT_BRIEF_ENABLED=
# 工作模式：assist=辅助 / autonomous=自主
WORK_MODE=

# ===== 个人 =====
NICKNAME=
AVATAR_URL=

# ===== 独立数据库（可留空则使用系统 SQLite）=====
DB_MODE=
DB_TYPE=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
