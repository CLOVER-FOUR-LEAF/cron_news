# =========================================================
# Cron News（定时资讯）配置模板
# 复制本文件为 .env 并按需填写后生效（.env 已被 git 忽略，不会提交）。
#
# 重要说明：
#   1. 大多数日常配置（工作模式、自动任务、模型/搜索服务等）都在网页「设置」里维护，
#      保存时会自动写回本文件，你通常**不需要**手工编辑这些字段。
#   2. 大语言 / 文生图 / 搜索服务的 Base URL、模型 ID、启用状态、API Key 统一存放在
#      数据库（model_configs 表），API Key 用下面的 SECRET_KEY 加密后入库，
#      **不要在 .env 里填模型 API Key**，请在「设置 → 模型服务配置」中维护。
#   3. 预设厂商参考见 README 底部表格。
# =========================================================

# ===== 加密密钥 =====
# 用于加密数据库中的模型 API Key。首次启动会自动生成并写回，请保留勿删除。
# 换掉它会导致已保存的 API Key 无法解密（需在网页里重新填写）。
# 不需要自己填，留空即可（自动生成）。
SECRET_KEY=

# ===== 定时任务（自主模式下由「设置 → 自动任务配置」自动生成，一般无需手填）=====
# 搜索计划 cron 表达式（例：0 */8 * * * = 每 8 小时）。由网页任务配置自动推导。
SEARCH_CRON=
# 最近一次采集时间（系统自动更新，用于启动补跑判断），无需手填。
LAST_SEARCH_TIME=
# 任务模式：preset=预设 / custom=自定义（网页「触发频率」里切换）
TASK_MODE=
# 任务间隔（小时）：1/3/6/8/12/24（网页「时间间隔」）
TASK_INTERVAL_HOURS=
# 每日首次执行小时：0~23（网页「每日开始时间」）
TASK_START_HOUR=
# 自定义 cron 表达式（仅 TASK_MODE=custom 时生效）
TASK_CUSTOM_CRON=
# 参与采集的标签 JSON 数组，例：["AI芯片","地缘政治"]（网页「关注标签」生成；留空则使用关注标签/记忆）
TASK_SELECTED_TAGS=

# ===== Agent =====
# 外部扩展提示词模式：preset=内置预设 / custom=自定义
AGENT_EXT_MODE=
# 自定义扩展提示词内容（仅 AGENT_EXT_MODE=custom 时生效）
AGENT_EXT_PROMPT=
# 功能开关（网页「设置 → Agent 管理」切换）：
# AGENT_RECOMMEND_ENABLED=true 启用「智能推荐」（需已启用大语言模型）
# AGENT_BRIEF_ENABLED=true     启用「每日简报」（需已启用大语言模型）
# 封面生成方式：image=文生图模型 / svg=大模型绘制矢量图（成本低一个数量级） / off=使用默认封面
# 旧的 AGENT_COVER_ENABLED 仍然兼容，等价于 AGENT_COVER_MODE=image
AGENT_COVER_MODE=
AGENT_RECOMMEND_ENABLED=
AGENT_BRIEF_ENABLED=
AGENT_COVER_ENABLED=
# ===== 对话助手 Agent（Phase 1）=====
# 是否启用 /chat 对话助手
AGENT_CHAT_ENABLED=true
# 工具协议：auto=自动探测 / native=原生 tools / json=JSON 协议兜底 / none=不调用工具（预检索一次）
AGENT_TOOL_PROTOCOL=auto
# 是否允许写操作工具（收藏、标记已读等）；默认关闭，公网暴露前请先完成鉴权
AGENT_ALLOW_WRITE_TOOLS=false
# 是否允许对话助手把采集/简报/推荐委派给对应的专职 Agent（默认开启）
AGENT_ALLOW_DELEGATION=true
# 单轮最多工具循环次数 / 工具调用次数 / 上下文 token 预算 / 每日 token 预算
AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOOL_CALLS=12
AGENT_CONTEXT_TOKENS=12000
AGENT_DAILY_TOKEN_BUDGET=300000
# 带入上下文的历史消息条数
AGENT_HISTORY_MESSAGES=12

# ===== 长期记忆与个性化 =====
# 是否启用长期记忆（Markdown 记忆 + 行为画像 + 反馈反思）。默认开启。
AGENT_MEMORY_ENABLED=true
# 记忆目录（默认项目下 memory/；PROFILE.md 会自动生成，不建议提交到 git）
AGENT_MEMORY_DIR=
# 记忆文件大小上限（字符）
AGENT_MEMORY_MAX_CHARS=60000
# 反馈写入后是否让 Agent 在后台反思并重写记忆段落（需已配置大语言模型）
AGENT_MEMORY_REFLECT=true
# 是否在每次反馈后自动触发后台反思任务（关闭后仍会写入确定性记忆，可手动刷新）
AGENT_FEEDBACK_REFLECT=true

# ===== 采集质量 =====
# 是否抓取原文（优于只用搜索摘要）；失败会自动回退，不影响入库
AGENT_ARTICLE_FETCH=true
AGENT_ARTICLE_FETCH_TIMEOUT=15
AGENT_ARTICLE_FETCH_CONCURRENCY=4
# 语义去重（需在「模型与服务配置」中启用 embedding 模型；未配置时自动只用标题/URL 去重）
AGENT_SEMANTIC_DEDUP=true
AGENT_DEDUP_THRESHOLD=0.92
AGENT_TITLE_DUP_THRESHOLD=0.82
# 最低可信度（0-100），低于阈值的内容不收录；可在采集日志里看到过滤数量
AGENT_MIN_CREDIBILITY=40
# 每轮采集最多收录条数，避免一次采集刷屏
AGENT_MAX_ITEMS_PER_RUN=24
# 搜索规划：让模型结合用户关注标签与记忆生成细分查询词（关闭则用标签启发式）
AGENT_QUERY_PLANNER=true
AGENT_COLLECT_QUERIES_PER_TAG=2

# 语义检索（需在「模型与服务配置」中启用一个 embedding 类型的模型）
AGENT_EMBED_ENABLED=true
AGENT_EMBED_MAX_PER_RUN=200
# 工作模式：assist=辅助（平台作展示，外部 Agent 推送）/ autonomous=自主（内置 Agent 自动采集）
# 在网页「工作模式」中切换，自动写回。
WORK_MODE=

# ===== 时区 =====
# 定时任务按进程本地时间计算槽位；显式固定可避免 systemd / nohup / docker 启动方式不同导致漂移
APP_TIMEZONE=Asia/Shanghai

# ===== 个人 =====
# 用户名（首次启动自动生成 User+6 位数字，可在「设置 → 个人资料」修改）
NICKNAME=
# 头像图片 URL（上传头像后自动写入，无需手填）
AVATAR_URL=

# ===== 反向代理子路径（可选）=====
# 使用 code-server / VS Code 的端口转发时，转发地址形如 https://host:8443/proxy/8000/。
# 设置该项后，应用会把 HTML/JS/CSS/JSON 里的根路径改写成 /proxy/8000/...
# 直连 http://局域网IP:8000 不受影响（按请求 Host 端口自动判断）。
# 如果代理没有保留原始 Host，可额外设置 APP_BASE_PATH_ALWAYS=1 强制启用。
APP_BASE_PATH=
APP_BASE_PATH_ALWAYS=

# ===== 独立数据库（可留空则使用系统内置 SQLite）=====
# 网页「设置 → 数据库」中配置并测试连接，保存后自动写回，一般无需手填。
# 留空即使用系统 SQLite（零配置开箱即用）。
# DB_MODE: system=系统 SQLite / standalone=独立数据库
DB_MODE=
# 数据库类型：mysql / mariadb / postgresql
DB_TYPE=
# 数据库主机地址
DB_HOST=
# 数据库端口（mysql/mariadb 默认 3306，postgresql 默认 5432）
DB_PORT=
# 数据库名称（会自动创建，如 cron_news）
DB_NAME=
# 数据库用户名
DB_USER=
# 数据库密码
DB_PASSWORD=

# ===== 首次使用向导 =====
# 完成（或跳过）向导后自动置为 true，用于判断是否需要再次弹出
ONBOARDING_DONE=
